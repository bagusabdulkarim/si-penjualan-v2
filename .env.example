# URL publik Web App GAS (diisi saat Fase 1)
GAS_URL=

# Token rahasia bersama antara Next.js dan GAS (disimpan di Script Properties GAS)
GAS_TOKEN=

# Kunci untuk menandatangani/mengenkripsi cookie sesi (hasilkan acak, min. 32 karakter)
SESSION_SECRET=

# Kunci untuk token CSRF (hasilkan acak, min. 32 karakter)
CSRF_SECRET=

# PENTING: jangan pernah commit file .env berisi nilai asli.
# Salin file ini menjadi .env lalu isi nilainya secara lokal / di Vercel.
